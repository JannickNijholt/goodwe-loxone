[Unit]
Description=GoodWe inverter to Modbus TCP bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=goodwe-modbus
EnvironmentFile=/etc/goodwe-modbus.env
ExecStart=/opt/goodwe-modbus/venv/bin/goodwe-modbus
Restart=always
RestartSec=10
# Modbus TCP uses port 502, which needs this capability as a non-root user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
