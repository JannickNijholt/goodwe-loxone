# GoodWe → Modbus bridge settings. Restart after changes: systemctl restart goodwe-modbus

# Inverter IP address (required). Give it a fixed IP / DHCP reservation.
GOODWE_HOST=
# 8899 = WiFi module (Modbus RTU over UDP), 502 = Modbus TCP dongle
#GOODWE_PORT=8899
# Inverter Modbus address; 0x7F is the goodwe library default for DT inverters
#GOODWE_COMM_ADDRESS=0x7F

# Modbus TCP port Loxone connects to. Use another port (e.g. 503) if something else,
# like onecta-modbus, already uses 502 on this host.
#GOODWE_MODBUS_PORT=502
# Status page; 0 = off
#GOODWE_WEB_PORT=8080

# Polling. Loxone reads from the bridge's cache, so this is the only load on the WiFi module.
#GOODWE_POLL_SECONDS=30
# While the inverter doesn't answer (night):
#GOODWE_OFFLINE_POLL_SECONDS=60
# Missed reads in a row before the inverter counts as offline:
#GOODWE_OFFLINE_AFTER=3
# How often to re-read the export limit settings:
#GOODWE_SETTINGS_SECONDS=600

# Writes from Loxone (export limit, clock sync). Off unless set to 1.
#GOODWE_ALLOW_WRITES=0
# Settings are stored in the inverter's EEPROM: cap the number of writes.
#GOODWE_MAX_WRITES_PER_HOUR=20
# Seconds to wait for more writes before sending (slider moves):
#GOODWE_WRITE_DEBOUNCE=2

#GOODWE_TIMEOUT=2
#GOODWE_RETRIES=2
#GOODWE_LOG_LEVEL=INFO
